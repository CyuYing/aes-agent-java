# 对外访问端口
APP_PORT=8080
# 默认仅允许本机访问；确认已启用鉴权和 HTTPS 后可改为 0.0.0.0。
APP_BIND_ADDRESS=127.0.0.1

# Docker/服务器版默认要求教师登录。
AES_SECURITY_ENABLED=true
AES_SECURITY_USERNAME=teacher
AES_SECURITY_PASSWORD=

# MySQL 密码。deploy.cmd/deploy.sh 会为空项自动生成随机值。
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
MYSQL_SANDBOX_PASSWORD=

# 文本批改模型。API Key 留空时应用仍可启动，选择题等本地功能可用。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# 推荐：千问同时承担文字与多模态批改；部署脚本识别 sk-ws- Key 后会自动填写。
GRADING_API_KEY=
GRADING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
GRADING_MODEL=qwen3.7-plus

# 图片批改默认关闭。下面默认值对应百炼 qwen3.7-plus。
VISION_ENABLED=false
VISION_API_KEY=
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_MODEL=qwen3.7-plus

# JVM 内存参数；默认使用容器可用内存的 75%。
JAVA_OPTS=-XX:MaxRAMPercentage=75 -Dfile.encoding=UTF-8 -Djava.io.tmpdir=/app/tmp
